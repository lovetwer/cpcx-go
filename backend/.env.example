# ===== 大奖来了 后端环境变量 =====
# 复制为 .env 后填值（本地用；Render 直接在后台 Environment 里填）

# 服务端口
PORT=8080

# MySQL 连接
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=lottery

# Token 签名密钥（生产务必改成随机长字符串）
JWT_SECRET=change-me-to-a-random-secret

# 中奖邮件通知（Resend）
# 没有就留空，系统会跳过邮件，只走推送
RESEND_API_KEY=
# 发件人，需是 Resend 里验证过的域名
RESEND_FROM=Lottery <onboarding@resend.dev>

# 中奖推送（通用 Webhook，POST JSON）
# 留空则跳过推送。可接 OneSignal / 自建推送网关等
PUSH_URL=
PUSH_TOKEN=

# 管理接口密钥（/api/admin/pull、/api/admin/check）
# 留空则任意登录用户都能触发；设置了则需在请求头带 x-admin-key
ADMIN_KEY=

# 定时任务间隔（分钟）
PULL_INTERVAL_MIN=30
CHECK_INTERVAL_MIN=15

# AI 预测 & 图片识别（Agnes agnes-2.5-flash）
# AI 预测和拍照识别彩票都走这个服务
AGNES_API_KEY=
AGNES_API_URL=https://apihub.agnes-ai.com/v1/chat/completions
AGNES_MODEL=agnes-2.5-flash
