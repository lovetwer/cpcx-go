<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- 彩种 -->
        <LinearLayout
            android:id="@+id/segType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_segment"
            android:padding="4dp"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/segSsq"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="双色球"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary" />

            <TextView
                android:id="@+id/segDlt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="大乐透"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/muted" />
        </LinearLayout>

        <!-- 玩法 -->
        <LinearLayout
            android:id="@+id/segMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_segment"
            android:padding="4dp"
            android:orientation="horizontal"
            android:layout_marginBottom="22dp">

            <TextView
                android:id="@+id/segSingle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="单式"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/primary" />

            <TextView
                android:id="@+id/segCompound"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="复式"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/muted" />

            <TextView
                android:id="@+id/segBanker"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="胆拖"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/muted" />
        </LinearLayout>

        <!-- 开奖日期 -->
        <LinearLayout
            android:id="@+id/issueCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="开奖日期"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text" />

            <Spinner
                android:id="@+id/issueSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />

            <EditText
                android:id="@+id/issueInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textSize="14sp"
                android:hint="如 2026-08-20"
                android:inputType="date"
                android:visibility="gone" />

            <TextView
                android:id="@+id/issueHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="默认选“未开奖”期，买的是未来开奖的彩票"
                android:textSize="12sp"
                android:textColor="@color/muted" />
        </LinearLayout>

        <!-- 选球器 -->
        <com.example.lottery.ui.widget.BallPickerView
            android:id="@+id/ballPicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp" />

        <!-- 实时已选预览 -->
        <LinearLayout
            android:id="@+id/previewCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp" />

        <!-- 图片识别 -->
        <LinearLayout
            android:id="@+id/ocrDrop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_ocr_drop"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_photo"
                android:tint="@color/primary" />

            <TextView
                android:id="@+id/ocrText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="上传彩票截图，自动识别号码"
                android:textSize="13sp"
                android:textFontWeight="500"
                android:textColor="@color/muted" />

            <ProgressBar
                android:id="@+id/ocrSpinner"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:indeterminateTint="@color/primary"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 多注识别结果 -->
        <LinearLayout
            android:id="@+id/multiContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="14dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- 批量录入入口 -->
        <TextView
            android:id="@+id/batchLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="批量录入（多张）"
            android:textSize="13sp"
            android:textColor="@color/muted"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:layout_marginBottom="14dp" />

        <!-- 倍数 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="倍数"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/stepper"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/stepMinus"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:gravity="center"
                    android:background="@drawable/bg_circle_primary"
                    android:text="−"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:includeFontPadding="false"
                    android:clickable="true"
                    android:focusable="true" />

                <EditText
                    android:id="@+id/stepInput"
                    android:layout_width="46dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:background="@null"
                    android:inputType="number"
                    android:text="1"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary" />

                <TextView
                    android:id="@+id/stepPlus"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:gravity="center"
                    android:background="@drawable/bg_circle_primary"
                    android:text="+"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:includeFontPadding="false"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- 底部保存栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/saveSummary1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text" />

                <TextView
                    android:id="@+id/saveSummary2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="12sp"
                    android:textColor="@color/muted" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/saveBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_primary"
                android:paddingTop="13dp"
                android:paddingBottom="13dp"
                android:clickable="true"
                android:focusable="true">

                <ProgressBar
                    android:id="@+id/saveSpinner"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="#ffffff"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/saveText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/btn_save"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
