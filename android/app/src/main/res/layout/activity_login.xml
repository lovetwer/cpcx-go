<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login"
    android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal|top"
            android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:paddingStart="30dp"
            android:paddingTop="34dp"
            android:paddingEnd="30dp"
            android:paddingBottom="34dp"
            android:elevation="10dp">

            <!-- 头部 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/logo"
                    android:scaleType="fitCenter"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="大奖来了"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="@color/text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="双色球 · 大乐透 彩票管理"
                    android:textSize="13sp"
                    android:textColor="@color/muted" />
            </LinearLayout>

            <!-- 模式切换：一键登录在最前 -->
            <LinearLayout
                android:id="@+id/tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_segment"
                android:padding="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabDevice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"
                    android:text="一键登录"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary" />

                <TextView
                    android:id="@+id/tabLogin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"
                    android:text="登录"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/muted" />

                <TextView
                    android:id="@+id/tabRegister"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"
                    android:text="注册"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/muted" />
            </LinearLayout>

            <!-- 表单 -->
            <LinearLayout
                android:id="@+id/form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="18dp">

                <LinearLayout
                    android:id="@+id/fieldUser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="14dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="用户名"
                        android:textSize="13sp"
                        android:textColor="@color/muted" />

                    <EditText
                        android:id="@+id/inputUser"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:textSize="14sp"
                        android:inputType="text"
                        android:importantForAutofill="no" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/fieldPass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="14dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="密码"
                        android:textSize="13sp"
                        android:textColor="@color/muted" />

                    <EditText
                        android:id="@+id/inputPass"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:textSize="14sp"
                        android:inputType="textPassword" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/fieldEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="14dp"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="邮箱（选填，中奖时用于通知）"
                        android:textSize="13sp"
                        android:textColor="@color/muted" />

                    <EditText
                        android:id="@+id/inputEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:textSize="14sp"
                        android:inputType="textEmailAddress" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/btnSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_btn_primary"
                    android:paddingTop="13dp"
                    android:paddingBottom="13dp"
                    android:layout_marginTop="4dp">

                    <ProgressBar
                        android:id="@+id/btnSpinner"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="#ffffff"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/btnText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="一键登录"
                        android:textColor="#ffffff"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="一键登录：本机生成持久设备号，下次打开自动登录，无需记密码；也可在「我的 → 编辑资料」里设置密码。"
                android:textSize="12sp"
                android:textColor="@color/muted" />

            <!-- 免责声明 -->
            <LinearLayout
                android:id="@+id/disclaimerCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="14dp"
                android:paddingTop="14dp"
                android:layout_gravity="center_horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_horizontal">

                    <CheckBox
                        android:id="@+id/cbAgree"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/primary"
                        android:text="我已阅读并同意"
                        android:textSize="13sp"
                        android:textColor="@color/muted" />

                    <TextView
                        android:id="@+id/tvDisclaimerLink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="《免责声明》"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDisclaimerBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="14dp"
                    android:background="@drawable/bg_input"
                    android:visibility="gone"
                    android:textSize="12sp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/muted"
                    android:text="免责声明\n\n本应用（大奖来了）仅供学习与交流使用，不涉及任何形式的博彩、投注或资金交易。\n\n应用中展示的开奖数据、彩票信息仅供参考，不构成任何购彩建议。请以中国体育彩票/中国福利彩票官方公告为准。\n\n用户在使用本应用时应遵守国家法律法规。因使用本应用而产生的任何直接或间接损失，开发者不承担任何责任。\n\n继续使用即视为您已阅读、理解并同意上述全部内容。" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
